# ─── LEJ Capital Management — Environment Variables ───
#
# Copy this file to .env.local and fill in real values.
# The app runs in "seed mode" (in-memory demo data) when these are absent.

# ─── Supabase Auth ───
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Database (Prisma 7 + @prisma/adapter-pg) ───
# Transaction pooler (port 6543) — used at runtime:
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (port 5432) — used for migrations only:
DIRECT_URL=postgresql://postgres.[project-ref]:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Admin ───
# Password for the seed-users.mjs script (shared across test accounts in dev):
LEJ_ADMIN_PASSWORD=your-secure-password-here

# ─── Local-only bypass ───
# Leave unset in production. Set to 1 only for local development if you need
# database-backed seed access without Supabase Auth.
# LEJ_ALLOW_DB_SEED_MODE=1

# ─── Operational automation (production only) ───
# Required to authenticate Vercel Cron requests.
CRON_SECRET=replace-with-a-long-random-secret

# Optional transactional email through Resend.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=LEJ Capital <noreply@your-domain.com>

# Optional WhatsApp delivery through Twilio. Automated borrower reminders only
# send when the borrower notes contain the explicit COMMS_OPT_IN token.
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_FROM=+14155238886
